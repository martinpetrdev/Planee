{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["*"],
  "ui": "tui",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^generate", "^build"]
    }
  }
}
