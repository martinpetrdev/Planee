{
	"$schema": "https://turborepo.org/schema.json",
	"globalDependencies": [
		".env"
	],
	"globalPassThroughEnv": [
		"*"
	],
	"ui": "tui",
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false,
			"dependsOn": [
				"^build"
			]
		},
		"generate": {
			"cache": true,
			"inputs": [
				"prisma/*.prisma",
				"prisma.config.ts"
			],
			"outputs": [
				"src/generated/**"
			]
		},
		"build": {
			"dependsOn": [
				"generate",
				"^build"
			],
			"outputs": [
				"dist/**"
			]
		},
		"android": {
			"persistent": true,
			"cache": false,
			"dependsOn": [
				"^build"
			]
		},
		"prebuild": {
			"persistent": true,
			"cache": false,
			"dependsOn": [
				"^build"
			]
		},
		"typecheck": {
			"persistent": false,
			"cache": false
		}
	}
}
